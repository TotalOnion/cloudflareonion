{
    "name": "totalonion/global-plugin-cfo",
    "description": "CloudFlare things",
    "license": "MIT",
    "type": "wordpress-plugin",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "autoload" : {
        "psr-4": {
            "global-plugin-cfo\\": "/src"
        },
        "files": [
            "src/Utils/functions.php",
            "src/Utils/crypt.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "/tests"
        }
    },
    "scripts": {
        "run-tests": [
            "phpunit --colors=always tests/"
        ]
    },
    "require": {
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.x-dev"
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
